    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": {"raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"]},
                        "body": {"mode": "raw", "raw": "{\n    \"name\": \"Arun Yadav\",\n    \"email\": \"heyarunyadav@gmail.com\",\n    \"phone\": \"9876543210\"\n}", "options": {"raw": {"language": "json"}}}
                    }
                },
                {
                    "name": "Login OTP",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": {"raw": "{{base_url}}/auth/login-otp", "host": ["{{base_url}}"], "path": ["auth", "login-otp"]},
                        "body": {"mode": "raw", "raw": "{\n    \"email\": \"admin@leadpro.com\"\n}", "options": {"raw": {"language": "json"}}}
                    }
                },
                {
                    "name": "Verify OTP",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": {"raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth", "verify-otp"]},
                        "body": {"mode": "raw", "raw": "{\n    \"email\": \"admin@leadpro.com\",\n    \"otp\": \"123456\"\n}", "options": {"raw": {"language": "json"}}}
                    }
                }
            ]
        },
        {
            "name": "User",
